<odoo>
<!--    <data noupdate="1">-->
    <data>
        <!-- SWTOR Admin group -->
        <record id="group_swtor_admin" model="res.groups">
            <field name="name">SWTOR Admin</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <!-- Make the server admin group inherit the SWTOR Admin group -->
<!--        <record id="base.group_system" model="res.groups">-->
<!--            <field name="implied_ids" eval="[(4, ref('swtor_armory.group_swtor_admin'))]"/>-->
<!--        </record>-->

        <!-- Record rule for swtor.character -->
        <record id="rule_swtor_character_own_only" model="ir.rule">
            <field name="name">SWTOR Character: Own Only</field>
            <field name="model_id" ref="model_swtor_character"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <!-- Record rule for swtor.loadout -->
        <record id="rule_swtor_loadout_own_only" model="ir.rule">
            <field name="name">SWTOR loadout: Own Only</field>
            <field name="model_id" ref="model_swtor_loadout"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <!-- Record rule for swtor.item -->
        <record id="rule_swtor_item_own_only" model="ir.rule">
            <field name="name">SWTOR item: Own Only</field>
            <field name="model_id" ref="model_swtor_item"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <!-- Record rule for swtor.character.crew.skill.relation -->
        <record id="rule_swtor_character_crew_skill_relation_own_only" model="ir.rule">
            <field name="name">SWTOR crew skills relations: Own Only</field>
            <field name="model_id" ref="model_swtor_character_crew_skill_relation"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <!-- Record rule for swtor.operation.lockout -->
        <record id="rule_swtor_operation_lockout_own_only" model="ir.rule">
            <field name="name">SWTOR lockouts: Own Only</field>
            <field name="model_id" ref="model_swtor_operation_lockout"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <record id="picking_warehouse_rule_admin" model="ir.rule">
            <field name="name">SWTOR Character: Admin</field>
            <field name="model_id" ref="model_swtor_character"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_swtor_admin'))]"/>
        </record>
    </data>
</odoo>