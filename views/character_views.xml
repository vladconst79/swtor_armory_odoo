<!-- character_views.xml -->
<odoo>
    <data>
        <!-- Tree view -->
        <record id="view_character_tree" model="ir.ui.view">
            <field name="name">swtor.character.tree</field>
            <field name="model">swtor.character</field>
            <field name="arch" type="xml">
                <tree string="Character">
                    <field name="display_name"/>
                    <field name="faction"/>
                    <field name="origin_story_id"/>
                    <field name="class_name_ids" widget="many2many_tags"/>
                    <field name="level"/>
                    <field name="race"/>
                    <field name="gender"/>
                    <field name="server"/>
                    <field name="guild"/>
                    <field name="alignment"/>
<!--                    <field name="crew_skills_ids" widget="many2many_tags"/>-->
<!--                    <field name="notes"/>-->
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_character_form" model="ir.ui.view">
            <field name="name">swtor.character.form</field>
            <field name="model">swtor.character</field>
            <field name="arch" type="xml">
                <form string="Character">
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                            <field name="faction_icon" widget='image' class="oe_avatar" style="margin-left:30px;"/>
                            <!--                        <field name="faction_icon_html" widget='html' class="oe_avatar" style="margin-left:30px;"/>-->
                        </h1>
                        <group>
                            <group>
                                <field name="faction"/>
                                <field name="origin_story_id"/>
                                <field name="class_name_ids" widget="many2many_tags"/>
                                <field name="level"/>
                                <field name="race"/>
                                <field name="gender"/>
                            </group>
                            <group>
                                <field name="server"/>
                                <field name="guild"/>
                                <field name="alignment"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Crew Skills" name="crew_skills">
                                <field name="crew_skills_ids">
                                    <tree editable="false" create="false">
                                        <field name="crew_skill_id"/>
                                        <field name="level"/>
                                        <field name="progress"/>
                                        <field name="skill_type" readonly="1"/>
                                    </tree>
                                </field>
                                <button name="%(action_crew_skill_wizard)d" string="Add Crew Skill" type="action" icon="fa-plus"/>
                            </page>
                            <page string="Operation Lockouts" name="operation_lockouts">
                                <field name="operation_lockouts_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="operation_id"/>
                                        <field name="difficulty_id"/>
                                        <field name="boss_id" attrs="{'readonly': [('operation_id', '=', False), ('difficulty_id', '=', False)]}" domain="[('operation_id', '=', operation_id)]"/>
                                        <field name="week"/>
                                        <field name="completion_rate" widget="progressbar"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" widget="html"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_character_search" model="ir.ui.view">
            <field name="name">swtor.character.search</field>
            <field name="model">swtor.character</field>
            <field name="arch" type="xml">
                <search string="Character">
                    <field name="name"/>
                    <field name="faction"/>
                    <field name="origin_story_id"/>
                    <field name="class_name_ids"/>
                    <field name="level"/>
                    <field name="race"/>
                    <field name="gender"/>
                    <field name="server"/>
                    <field name="guild"/>
                    <field name="alignment"/>
<!--                    <field name="crew_skills_ids"/>-->
                </search>
            </field>
        </record>

        <!-- Action to open the correct view -->
        <record id="action_character" model="ir.actions.act_window">
            <field name="name">Characters</field>
            <field name="res_model">swtor.character</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_character_search"/>
        </record>

        <!-- Menu item to access the character views -->
        <menuitem id="menu_character" name="Characters" action="action_character"/>
    </data>
</odoo>