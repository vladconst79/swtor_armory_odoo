<!-- character_views.xml -->
<odoo>
    <data>
        <!-- Tree view -->
        <record id="view_character_tree" model="ir.ui.view">
            <field name="name">swtor.character.tree</field>
            <field name="model">swtor.character</field>
            <field name="arch" type="xml">
                <tree string="Character">
                    <field name="sequence" widget="handle"/>
                    <field name="display_name"/>
                    <field name="faction" optional="show"/>
                    <field name="origin_story_id" optional="show"/>
                    <field name="class_name_ids" widget="many2many_tags" optional="show"/>
                    <field name="role_ids" widget="many2many_tags" optional="show" options="{'color_field': 'color'}"/>
                    <field name="level" optional="show"/>
                    <field name="race" optional="show"/>
                    <field name="gender" optional="show"/>
                    <field name="server"/>
                    <field name="guild_image" widget="image" class="vehicle_icon"/>
                    <field name="guild_id"/>
                    <field name="alignment" decoration-danger="alignment == 'dark'" decoration-info="alignment == 'light'" optional="show"/>
<!--                    <field name="crew_skills_ids" widget="many2many_tags"/>-->
<!--                    <field name="notes"/>-->
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_character_form" model="ir.ui.view">
            <field name="name">swtor.character.form</field>
            <field name="model">swtor.character</field>
            <field name="arch" type="xml">
                <form string="Character">
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                            <field name="faction_icon" widget='image' class="oe_avatar" style="margin-left:30px;"/>
                            <!--                        <field name="faction_icon_html" widget='html' class="oe_avatar" style="margin-left:30px;"/>-->
                        </h1>
                        <group>
                            <group>
                                <field name="faction"/>
                                <field name="origin_story_id"/>
                                <field name="class_name_ids" widget="many2many_tags"/>
                                <field name="available_role_ids" invisible="1"/>
                                <field name="role_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <field name="level"/>
                                <field name="race"/>
                                <field name="gender"/>
                            </group>
                            <group>
                                <field name="server"/>
                                <field name="guild_id"/>
                                <field name="alignment"/>
                                <field name="valor_rank"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Operation Lockouts" name="operation_lockouts">
                                <field name="operation_lockouts_ids">
                                    <tree editable="bottom" default_order="week desc">
                                        <field name="name"/>
                                        <field name="operation_id" required="1"/>
                                        <field name="difficulty_id" attrs="{'readonly': [('operation_id', '=', False)]}" domain="[('operation_ids', 'in', operation_id)]" required="1"/>
                                        <field name="boss_id" attrs="{'readonly': [('operation_id', '=', False), ('difficulty_id', '=', False)]}" domain="[('operation_id', '=', operation_id)]" required="1"/>
                                        <field name="week" required="1"/>
                                        <field name="completion_rate" widget="progressbar"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Crew Skills" name="crew_skills">
                                <field name="crew_skills_ids">
                                    <tree editable="false" create="false" default_order="skill_type">
                                        <field name="crew_skill_id"/>
                                        <field name="level"/>
                                        <field name="skill_type" readonly="1"/>
                                        <field name="progress" widget="progressbar"/>
                                    </tree>
                                </field>
                                <field name="crew_skills_count" invisible="1"/>
                                <button name="%(action_crew_skill_wizard)d" string="Add Crew Skill" type="action" icon="fa-plus" attrs="{'invisible': [('crew_skills_count', '>=', 3)]}"/>
                            </page>
                            <page string="Loadouts" name="loadouts">
                                <field name="loadout_ids" context="{'tree_but_open': True}">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <button name="open_record"
                                                string="Open"
                                                type="object"
                                                icon="fa-external-link"/>
                                        <field name="loadout_type"/>
                                        <field name="character_role_ids" invisible="1" string=""/>
                                        <field name="spec_id"/>
                                        <field name="role_icon" widget="image" class="vehicle_icon"/>
                                        <field name="role_id"/>
                                        <field name="loadout_url" widget="url"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Items" name="items">
                                <field name="item_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                        <field name="rarity" optional="show"/>
                                        <field name="binding" optional="show"/>
                                        <field name="bound" optional="show"/>
                                        <field name="cargo_hold" optional="show"/>
                                        <field name="cargo_bay" optional="show"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Titles" name="titles">
                                <field name="title_ids"/>
                            </page>
                            <page string="Mounts" name="mounts">
                                <field name="vehicle_ids">
                                    <tree>
                                        <field name="icon" widget="image" class="vehicle_icon"/>
                                        <field name="name"/>
                                        <field name="source"/>
<!--                                        <field name="name" widget="icon_name_widget" options="{'icon': 'icon', 'name': 'name'}"/>-->
                                    </tree>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" widget="html"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_character_search" model="ir.ui.view">
            <field name="name">swtor.character.search</field>
            <field name="model">swtor.character</field>
            <field name="arch" type="xml">
                <search string="Character">
                    <field name="name"/>
                    <field name="faction"/>
                    <field name="origin_story_id"/>
                    <field name="class_name_ids"/>
                    <field name="level"/>
                    <field name="race"/>
                    <field name="gender"/>
                    <field name="server"/>
                    <field name="guild_id"/>
                    <field name="alignment"/>
<!--                    <field name="crew_skills_ids"/>-->
                    <field name="role_ids"/>
                    <filter string="Server" name="groupby_server" context="{'group_by':'server'}"/>
                    <filter string="Faction" name="groupby_faction" context="{'group_by':'faction'}"/>
                    <filter string="Guild" name="groupby_guild" context="{'group_by':'guild_id'}"/>
                    <filter string="Advanced Class" name="groupby_class" context="{'group_by':'class_name_ids'}"/>
                    <filter string="Role" name="groupby_role" context="{'group_by':'role_ids'}"/>
                    <filter string="My Toons" name="my_toons" domain="[('create_uid', '=', uid)]"/>
                    <separator/>
                    <filter string="Empire" name="empire_toons" domain="[('faction', '=', 'empire')]"/>
                    <filter string="Republic" name="republic_toons" domain="[('faction', '=', 'republic')]"/>
                    <separator/>
                    <filter string="Tanks" name="tanks" domain="[('role_ids.name', '=', 'Tank')]"/>
                    <filter string="DPS" name="dps" domain="[('role_ids.name', '=', 'DPS')]"/>
                    <filter string="Healers" name="healers" domain="[('role_ids.name', '=', 'Healer')]"/>
                </search>
            </field>
        </record>

        <!-- Kanban view -->
        <record id="view_character_kanban" model="ir.ui.view">
            <field name="name">swtor.character.kanban</field>
            <field name="model">swtor.character</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="server" default_order="sequence">
                    <field name="sequence"/>
                    <field name="server"/>
                    <field name="faction"/>
                    <field name="alignment"/>
                    <progressbar field="faction" colors='{"empire": "danger", "republic": "info"}'/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_details">
                                        <div class="o_kanban_content">
                                            <div class="d-flex align-items-center">
                                                <t t-if="record.guild_image.raw_value">
                                                    <field name="guild_image" widget="image" class="oe_avatar" style="width: 20px; height: 20px;"/>
                                                </t>
                                                <h2 class="ml-2" style="margin-left: 5px;">
                                                    <field name="name"/>
                                                </h2>
                                            </div>
                                            <field name="faction_icon" widget="image" style="width: 50px; height: 50px; position: absolute; top: 10px; right: 10px;"/>
                                            <field name="class_name_ids" widget="many2many_tags" style="display: flex; flex-wrap: wrap; justify-content: space-between;"/>
                                            <field name="role_ids" widget="many2many_tags"  options="{'color_field': 'color'}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Loadout form view -->
        <record id="view_loadout_form" model="ir.ui.view">
            <field name="name">swtor.loadout.form</field>
            <field name="model">swtor.loadout</field>
            <field name="arch" type="xml">
                <form string="Loadout">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="spec_id"/>
                            <field name="loadout_type"/>
                            <field name="loadout_url"/>
                        </group>
                        <group>
                            <label for="loadout_iframe"/>
                            <field name="loadout_iframe" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>