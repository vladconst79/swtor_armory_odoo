<odoo>
    <data>
        <!-- Tree view -->
        <record id="view_class_name_tree" model="ir.ui.view">
            <field name="name">swtor.class.name.tree</field>
            <field name="model">swtor.class.name</field>
            <field name="arch" type="xml">
                <tree string="Class Name">
                    <field name="name"/>
                    <field name="power_type"/>
                    <field name="class_icon" widget="image"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_class_name_form" model="ir.ui.view">
            <field name="name">swtor.class.name.form</field>
            <field name="model">swtor.class.name</field>
            <field name="arch" type="xml">
                <form string="Class Name">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="power_type"/>
                                <field name="role_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <field name="spec_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </group>
                            <group>
                                <field name="class_icon" widget="image"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Characters">
                                <field name="all_character_ids"/>

                            </page>
                            <page string="Loadouts">
                                <field name="loadout_ids">
                                    <tree>
                                        <field name="character_id"/>
                                        <field name="name"/>
                                        <button name="open_record"
                                                string="Open"
                                                type="object"
                                                icon="fa-external-link"/>
                                        <field name="loadout_type"/>
                                        <field name="character_role_ids" invisible="1" string=""/>
<!--                                        <field name="spec_id_domain" invisible="1"/>-->
                                        <field name="spec_id"/>
<!--                                        <field name="spec_id" domain="spec_id_domain"/>-->
                                        <field name="role_icon" widget="image" class="vehicle_icon"/>
                                        <field name="role_id"/>
                                        <field name="loadout_url" widget="url"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_class_name_search" model="ir.ui.view">
            <field name="name">swtor.class.name.search</field>
            <field name="model">swtor.class.name</field>
            <field name="arch" type="xml">
                <search string="Class Name">
                    <field name="name"/>
                    <field name="power_type"/>
                </search>
            </field>
        </record>
    </data>
</odoo>