<odoo>
    <data>
        <menuitem id="menu_swtor_root"
                  name="SWTOR"
                  sequence="1"
                  web_icon="swtor_armory,static/src/icon/swtor_icon.png"/>

        <menuitem id="menu_swtor_characters"
                  name="Characters"
                  parent="menu_swtor_root"
                  action="action_character"/>

        <record id="action_character" model="ir.actions.act_window">
            <field name="name">Characters</field>
            <field name="res_model">swtor.character</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Action to open the correct view -->
        <record id="action_crew_skill" model="ir.actions.act_window">
            <field name="name">Crew Skills</field>
            <field name="res_model">swtor.crew.skill</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_crew_skill_search"/>
        </record>

        <!-- Menu item to access the crew skill views -->
        <menuitem id="menu_crew_skill"
                  name="Crew Skills"
                  parent="menu_swtor_root"
                  action="action_crew_skill"/>
    </data>
</odoo>