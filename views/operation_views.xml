<odoo>
    <data>
        <!-- Tree view -->
        <record id="view_swtor_operation_tree" model="ir.ui.view">
            <field name="name">swtor.operation.tree</field>
            <field name="model">swtor.operation</field>
            <field name="arch" type="xml">
                <tree string="SWTOR Operation">
                    <field name="name"/>
                    <field name="difficulty_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_swtor_operation_form" model="ir.ui.view">
            <field name="name">swtor.operation.form</field>
            <field name="model">swtor.operation</field>
            <field name="arch" type="xml">
                <form string="SWTOR Operation">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="difficulty_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <notebook>
                            <page string="Bosses">
                                <field name="boss_ids">
                                    <tree editable="bottom" default_order="sequence">
                                        <field name="sequence" widget="handle" groups="swtor_armory.group_swtor_admin"/>
                                        <field name="name"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Titles" name="titles">
                                <field name="title_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="type"/>
                                        <field name="operation_difficulty_id"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Mounts" name="mounts">
                                <field name="vehicle_ids">
                                    <tree>
                                        <field name="icon" widget="image" class="vehicle_icon"/>
                                        <field name="name"/>
                                        <field name="bind"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Tree view -->
        <record id="view_swtor_operation_difficulty_tree" model="ir.ui.view">
            <field name="name">swtor.operation.difficulty.tree</field>
            <field name="model">swtor.operation.difficulty</field>
            <field name="arch" type="xml">
                <tree string="SWTOR Operation Difficulty">
                    <field name="name"/>
                    <field name="full_name"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_swtor_operation_difficulty_form" model="ir.ui.view">
            <field name="name">swtor.operation.difficulty.form</field>
            <field name="model">swtor.operation.difficulty</field>
            <field name="arch" type="xml">
                <form string="SWTOR Operation Difficulty">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="full_name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree view -->
        <record id="view_operation_lockout_tree" model="ir.ui.view">
            <field name="name">swtor.operation.lockout.tree</field>
            <field name="model">swtor.operation.lockout</field>
            <field name="arch" type="xml">
                <tree string="Operation Lockout" editable="top">
                    <field name="name"/>
                    <field name="faction"/>
                    <field name="character_id" required="1"/>
                    <field name="operation_id"/>
                    <field name="difficulty_id" attrs="{'readonly': [('operation_id', '=', False)]}" domain="[('operation_ids', 'in', operation_id)]" required="1"/>
                    <field name="boss_id" attrs="{'readonly': [('operation_id', '=', False), ('difficulty_id', '=', False)]}" domain="[('operation_id', '=', operation_id)]" required="1"/>
                    <field name="week" required="1"/>
                    <field name="completion_rate" widget="progressbar"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_operation_lockout_form" model="ir.ui.view">
            <field name="name">swtor.operation.lockout.form</field>
            <field name="model">swtor.operation.lockout</field>
            <field name="arch" type="xml">
                <form string="Operation Lockout">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="week"/>
                            <field name="character_id"/>
                            <field name="boss_id"/>
                            <field name="operation_id"/>
                            <field name="difficulty_id"/>
                            <field name="completion_rate"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_operation_lockout_search" model="ir.ui.view">
            <field name="name">swtor.operation.lockout.search</field>
            <field name="model">swtor.operation.lockout</field>
            <field name="arch" type="xml">
                <search string="Operation Lockout">
                    <field name="name"/>
                    <field name="week"/>
                    <field name="character_id"/>
                    <field name="boss_id"/>
                    <field name="operation_id"/>
                    <field name="difficulty_id"/>
                    <field name="completion_rate"/>
                    <filter string="Operation" name="groupby_operation" context="{'group_by':'operation_id'}"/>
                    <filter string="Difficulty" name="groupby_difficulty" context="{'group_by':'difficulty_id'}"/>
                    <filter string="Faction" name="groupby_faction" context="{'group_by':'faction'}"/>
                    <filter string="Character" name="groupby_character" context="{'group_by':'character_id'}"/>
                    <filter string="Current Week" name="current_week" domain="[('week', '&gt;=', ((context_today()+relativedelta(weeks=-1, weekday=1))).strftime('%Y-%m-%d'))]" help="Show only entries since last Tuesday"/>
                </search>
            </field>
        </record>

    </data>
</odoo>