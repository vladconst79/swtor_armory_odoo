<odoo>
    <data>
        <!-- Tree view -->
        <record id="view_vehicle_tree" model="ir.ui.view">
            <field name="name">swtor.ehicle.tree</field>
            <field name="model">swtor.vehicle</field>
            <field name="arch" type="xml">
                <tree string="Vehicles">
                    <field name="icon" widget="image" class="vehicle_icon"/>
                    <field name="name"/>
                    <field name="source"/>
                </tree>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_vehicle_form" model="ir.ui.view">
            <field name="name">swtor.vehicle.form</field>
            <field name="model">swtor.vehicle</field>
            <field name="arch" type="xml">
                <form string="Mount">
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                            <field name="icon" widget='image' class="oe_avatar" style="margin-left:30px;"/>
                        </h1>
                        <group>
                            <group>
                                <field name="source"/>
                                <field name="icon_filename" invisible="True"/>
                                <field name="icon_url"/>
                                <field name="bind"/>
                            </group>
                            <group>
                                <field name="operation_id" attrs="{'invisible': [('source', '!=', 'operation')]}"/>
                                <field name="operation_difficulty_id" attrs="{'invisible' :[('source', '!=', 'operation')], 'readonly': [('operation_id', '=', False)]}" domain="[('operation_ids', 'in', operation_id)]"/>

                            </group>
                        </group>
                        <notebook>
                            <page string="Characters" name="characters">
                                <field name="character_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_vehicle_search" model="ir.ui.view">
            <field name="name">swtor.vehicle.search</field>
            <field name="model">swtor.vehicle</field>
            <field name="arch" type="xml">
                <search string="Vehicles">
                    <field name="name"/>
                    <field name="source"/>
                    <field name="operation_id"/>
                    <field name="character_ids"/>
                    <filter name="groupby_source" string="Source" context="{'group_by':'source'}"/>
                    <filter name="groupby_character" string="Character" context="{'group_by':'character_ids'}"/>
                </search>
            </field>
        </record>
    </data>
</odoo>